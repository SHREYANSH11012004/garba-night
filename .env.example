MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
EMAIL_VERIFICATION_OTP_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_VERIFIED_TTL_SECONDS=900